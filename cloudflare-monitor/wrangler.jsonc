{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ansem-distribution-monitor",
  "main": "src/entry.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_API_RATE_LIMITER",
      "namespace_id": "910701",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RPC_RATE_LIMITER",
      "namespace_id": "910702",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ansem-distribution-db",
      "database_id": "5e7879ac-727c-431f-8e79-2bb572e288ca",
      "migrations_dir": "migrations"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "SOLANA_RPC_URL",
      "store_id": "9bec77bd6cbe44a9ac278c3e7248df53",
      "secret_name": "ANSEM_SOLANA_RPC"
    }
  ]
}
